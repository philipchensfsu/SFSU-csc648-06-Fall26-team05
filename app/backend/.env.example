# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings > API). Never commit the real .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Discord bot (feature 04). Optional: without them the /api/bot routes return
# 503 bot_not_configured. SUPABASE_JWT_SECRET is the project's legacy JWT
# secret (Project Settings > JWT Keys; locally `supabase status`).
# BOT_API_SECRET is any long random string; the bot sends the same one.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
# BOT_API_SECRET=a-long-random-string

# Gemini, for the AI features. For local testing, make your own free key at
# https://aistudio.google.com/apikey instead of using the deployed one.
# Without a key the app still runs; only AI requests fail.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to the model in ai/gemini_client.py.
# GEMINI_MODEL=gemini-3-flash-preview
# Optional. Set to false to switch every AI request off.
# AI_ENABLED=true
