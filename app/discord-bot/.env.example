# Copy to .env (never commit .env) or set these in Railway's Variables tab.
# The bot token from the Discord Developer Portal (Bot > Reset Token). Secret.
DISCORD_BOT_TOKEN=
# Where the Nautilus API lives: https://csc648-team05.vercel.app in production,
# http://localhost:8000 against the local stack.
NAUTILUS_API_URL=http://localhost:8000
# Must equal the backend's BOT_API_SECRET. Secret. compose.yaml's local value
# (from Vineela's #171) is local-bot-secret.
BOT_API_SECRET=
# Optional. Seconds to wait for the backend; /summary waits longer for the AI.
# BOT_REQUEST_TIMEOUT_SECONDS=20
# BOT_SUMMARY_TIMEOUT_SECONDS=290
