# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings > API). Never commit the real .env.local file.
# NEXT_PUBLIC_ vars are exposed to the browser -- only the anon key belongs here,
# never the service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
